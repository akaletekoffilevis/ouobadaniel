# URL publique du site (utilisée pour SEO : canonical, sitemap, og)
# À remplacer par le vrai domaine une fois en ligne (ex: https://impactcreation.com)
NEXT_PUBLIC_SITE_URL=https://ouobadaniel.vercel.app

# ===== Supabase =====
# 1. https://supabase.com → New project
# 2. Project Settings → API → copiez ici :
SUPABASE_URL=https://votreprojet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=collez-la-cle-service-role-ici

# ===== Connexion Postgres (utilisée par npm run seed pour créer les tables) =====
# Format pooler : postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres

# ===== Admin =====
# Secret utilisé pour signer les sessions admin (longue chaîne aléatoire).
# Générez-en une :  openssl rand -base64 32
AUTH_SECRET=collez-une-longue-chaine-aleatoire

# ===== Seed (optionnel, utilisé par scripts/seed.mjs) =====
# Mot de passe admin par défaut lors du premier seed (par défaut : impact2026)
DEFAULT_ADMIN_PASSWORD=impact2026
